<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleDisplayName</key>
	<string>da transcribuh</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>da transcribuh</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>da transcribuh records the microphone during a session so it can type what you say next to each screenshot.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>da transcribuh captures the display when you release shift so it can save a still with your marks baked in.</string>
	<!-- Bundled OFL fonts live in PromptAnnotator/Fonts/ → Resources/Fonts/.
	     InkFontRegistrar also CTFontManager-registers every .otf at launch. -->
	<key>ATSApplicationFontsPath</key>
	<string>Fonts</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<!-- Sparkle 2. See docs/releasing.md ("auto-updates"). The feed is served by the public
	     website (bicrick/da-transcribuh-site) so it works while this repo stays private.
	     Keep this vercel.app URL even after a custom domain is added: it keeps resolving. -->
	<key>SUFeedURL</key>
	<string>https://da-transcribuh-site.vercel.app/appcast.xml</string>
	<!-- Public half of the EdDSA key. The private half lives only in Patrick's login Keychain
	     (generate_keys, account ed25519). -->
	<key>SUPublicEDKey</key>
	<string>G6SPYolzL6cJ7xbOSHKEttfAfRfUKrVPUfdwCXSjvus=</string>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
</dict>
</plist>
