// Developer ID release signing. Used only by scripts/release.sh (passed with -xcconfig),
// so project.pbxproj keeps its local-dev signing and in-flight PRs don't conflict.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application
DEVELOPMENT_TEAM = 3BUPEZ2FJQ
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
OTHER_CODE_SIGN_FLAGS = --timestamp
